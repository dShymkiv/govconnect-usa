# Server
PORT=3001
NODE_ENV=development
HOST=127.0.0.1

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

DATA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# Storage: json (default local dumps) | postgres (Docker)
STORAGE_DRIVER=json
# STORAGE_DRIVER=postgres
# DATABASE_URL=postgres://govconnect:govconnect_dev@127.0.0.1:5432/govconnect
# DATABASE_SSL=false

# SMS OTP
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Leave unset for auto (devCode with mock only; hidden when Twilio is active)
# OTP_DEV_RETURN_CODE=false

# Twilio SMS — https://console.twilio.com
# SMS_PROVIDER: auto | twilio | mock
SMS_PROVIDER=auto
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 Twilio number (Messages API / upgraded accounts)
TWILIO_FROM_NUMBER=
# Verify Service SID — required for real OTP on Twilio trial
# Console → Verify → Services → Create → copy SID (VA...)
TWILIO_VERIFY_SERVICE_SID=
# Trial cannot send custom SMS body via Messages API
TWILIO_TRIAL_TEMPLATES=true
